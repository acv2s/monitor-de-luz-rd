# ===== Edenorte (Oficina Virtual) =====
EDENORTE_EMAIL=tu-correo@ejemplo.com
EDENORTE_PASSWORD=tu-contraseña
# Opcional: si lo dejas vacío, el script detecta el NIC solo desde "Mis Contratos"
EDENORTE_NIC=1234567

# ===== Base de datos (Neon o Supabase — cualquier Postgres) =====
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require

# ===== Alertas por Telegram =====
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ===== Reglas de alarma =====
# Umbral mensual en kWh (alarma cuando la proyección o el consumo real lo superan)
KWH_THRESHOLD=700
# Aviso temprano al alcanzar este % del umbral (0.8 = 80%)
KWH_WARN_RATIO=0.8
# Mandar un resumen por Telegram TODOS los días (true/false), además de las alarmas
DAILY_SUMMARY=true
# Un día se considera "alarmante" si supera este múltiplo del promedio diario del ciclo
DAILY_SPIKE_RATIO=1.6

# ===== Seguridad =====
# Vercel lo manda automáticamente en el header Authorization del cron. Genera uno largo y aleatorio.
CRON_SECRET=cambia-esto-por-un-secreto-largo
# Contraseña para entrar al dashboard (usuario: cualquiera). Si lo dejas vacío, el dashboard queda abierto.
DASHBOARD_PASSWORD=

# ===== Notas de voz (opcional) =====
# Transcribe los audios que le mandes al bot. Usa el primero que esté puesto.
# Groq es gratis hasta un límite generoso y es el más rápido: console.groq.com/keys
GROQ_API_KEY=
# Alternativa: OPENAI_API_KEY (también sirve para que el bot responda hablando)
OPENAI_API_KEY=
# Pon true si además quieres que el bot te CONTESTE con una nota de voz
VOICE_REPLIES=false
# Voz más natural en español (opcional): elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===== Retención =====
# Meses que se guarda el PDF de cada factura (los datos leídos se guardan siempre)
PDF_RETENTION_MONTHS=3
